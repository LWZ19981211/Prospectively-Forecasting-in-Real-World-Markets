  Diff        = round(mean(diff_vec, na.rm = TRUE), 4), # 正值代表美国模型误差更大，负值代表中国模型误差更大
  t_stat      = round(t_stat, 3),
  df          = df_val,
  p_value     = ifelse(p_val < 0.001, "< 0.001", sprintf("%.4f", p_val)),
  Cohens_d    = round(cohen_d, 3)
)

